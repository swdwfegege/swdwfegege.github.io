        body {
            background: #000;
            color: white;
            font-family: Arial, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* SPACE BACKGROUND */
        .space {
            position: fixed;
            inset: 0;
            overflow: hidden;
            z-index: -2;
            background:
                radial-gradient(
                    circle at 50% 45%,
                    #151515 0%,
                    #080808 35%,
                    #000 75%
                );
        }

        /* STAR LAYERS */
        .stars,
        .stars2,
        .stars3 {
            position: absolute;
            inset: -100%;
            width: 300%;
            height: 300%;

            background-image:
                radial-gradient(2px 2px at 20px 30px, white, transparent),
                radial-gradient(1px 1px at 80px 90px, white, transparent),
                radial-gradient(2px 2px at 150px 120px, #aaa, transparent),
                radial-gradient(1px 1px at 200px 40px, white, transparent),
                radial-gradient(2px 2px at 300px 200px, #888, transparent),
                radial-gradient(1px 1px at 400px 150px, white, transparent),
                radial-gradient(2px 2px at 500px 300px, #aaa, transparent);

            background-size: 550px 400px;
        }

        .stars {
            animation: starsMove 80s linear infinite;
            opacity: 0.8;
        }

        .stars2 {
            animation: starsMove 120s linear infinite reverse;
            opacity: 0.45;
            transform: scale(1.3);
        }

        .stars3 {
            animation: starsMove 160s linear infinite;
            opacity: 0.25;
            transform: scale(1.6);
        }

        @keyframes starsMove {
            from {
                transform: translate(0, 0);
            }

            to {
                transform: translate(-400px, -300px);
            }
        }

        /* GLOWING SPACE ORB */
        .orb {
            position: fixed;
            width: 600px;
            height: 600px;
            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(100, 100, 255, 0.14),
                    rgba(0, 0, 0, 0) 70%
                );

            top: 15%;
            left: 50%;
            transform: translateX(-50%);

            animation: orbPulse 6s ease-in-out infinite;
            z-index: -1;
        }

        @keyframes orbPulse {
            0%, 100% {
                transform: translateX(-50%) scale(1);
                opacity: 0.5;
            }

            50% {
                transform: translateX(-50%) scale(1.25);
                opacity: 1;
            }
        }

        /* MAIN */
        .container {
            width: 92%;
            max-width: 1250px;
            margin: auto;
            padding: 70px 0;
        }

        /* HEADER */
        .header {
            text-align: center;
            margin-bottom: 50px;
        }

        .header h1 {
            font-size: 52px;
            letter-spacing: 9px;
            text-transform: uppercase;

            text-shadow:
                0 0 10px white,
                0 0 25px #777,
                0 0 50px #333;

            animation: titleGlow 3s ease-in-out infinite;
        }

        .header p {
            margin-top: 15px;
            color: #777;
            font-size: 14px;
            letter-spacing: 4px;
        }

        @keyframes titleGlow {
            0%, 100% {
                text-shadow:
                    0 0 10px white,
                    0 0 25px #555;
            }

            50% {
                text-shadow:
                    0 0 20px white,
                    0 0 40px #888,
                    0 0 70px #444;
            }
        }

        /* VIDEO GRID */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
        }

        /* VIDEO CARD */
        .video-card {
            background: rgba(10, 10, 10, 0.82);
            border: 1px solid #222;
            border-radius: 15px;

            padding: 15px;

            box-shadow:
                0 0 20px rgba(255, 255, 255, 0.03),
                inset 0 0 30px rgba(255, 255, 255, 0.02);

            backdrop-filter: blur(10px);

            transition:
                transform 0.3s ease,
                border-color 0.3s ease,
                box-shadow 0.3s ease;
        }

        .video-card:hover {
            transform: translateY(-7px);

            border-color: #555;

            box-shadow:
                0 0 30px rgba(255, 255, 255, 0.12),
                0 0 70px rgba(255, 255, 255, 0.04);
        }

        /* VIDEO TITLE */
        .video-title {
            font-size: 18px;
            color: #ddd;
            margin-bottom: 12px;
            letter-spacing: 1px;
        }

        /* VIDEO */
        .video-wrapper {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;

            overflow: hidden;
            border-radius: 10px;

            background: #000;
        }

        .video-wrapper iframe {
            position: absolute;
            width: 100%;
            height: 100%;

            left: 0;
            top: 0;

            border: none;
        }

        /* BOTTOM LINE */
        .bottom-line {
            width: 60%;
            height: 1px;

            margin: 70px auto 0;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    #777,
                    white,
                    #777,
                    transparent
                );

            box-shadow: 0 0 15px white;

            animation: linePulse 3s ease-in-out infinite;
        }

        @keyframes linePulse {
            0%, 100% {
                opacity: 0.3;
            }

            50% {
                opacity: 1;
            }
        }

        /* MOBILE */
        @media (max-width: 800px) {

            .video-grid {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 35px;
                letter-spacing: 5px;
            }
        }

        @media (max-width: 500px) {

            .container {
                width: 94%;
                padding-top: 40px;
            }

            .header h1 {
                font-size: 27px;
                letter-spacing: 3px;
            }

            .header p {
                font-size: 11px;
            }
        }
    </style>
</head>

